{
  "name": "tauri-python-sidecar",
  "version": "0.1.1",
  "private": true,
  "description": "Template for shipping a supervised Python sidecar inside a Tauri v2 app on Windows",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter ui dev",
